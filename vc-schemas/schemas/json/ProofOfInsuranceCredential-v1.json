{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://sfilangio01.github.io/vc-schemas/schemas/json-ld/ProofOfInsurance-v1.json-ld",
      "jsonSchema": "https://sfilangio01.github.io/vc-schemas/schemas/json/ProofOfInsuranceCredential-v1.json"
    },
    "serialization": {
      "indexDataSlotA": "policyNumber",
      "indexDataSlotB": "coverageType"
    }
  },
  "required": [
    "@context",
    "id",
    "type",
    "issuanceDate",
    "credentialSubject",
    "credentialSchema",
    "credentialStatus",
    "issuer"
  ],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "id": { "type": "string" },
    "type": { "type": ["string", "array"], "items": { "type": "string" } },
    "issuer": { "type": ["string", "object"], "format": "uri", "required": ["id"], "properties": { "id": { "type": "string", "format": "uri" } } },
    "issuanceDate": { "type": "string", "format": "date-time" },
    "expirationDate": { "type": "string", "format": "date-time" },
    "credentialSchema": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string", "format": "uri" }, "type": { "type": "string" } } },
    "subjectPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "merklizationRootPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "revNonce": { "type": "integer" },
    "version": { "type": "integer" },
    "updatable": { "type": "boolean" },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "policyNumber", "insuranceProvider", "coverageType", "validFromDate", "validThroughDate"],
      "properties": {
        "id": { "title": "Credential Subject ID", "type": "string", "format": "uri" },
        "policyNumber": { "type": "string", "description": "Unique insurance policy number" },
        "insuranceProvider": { "type": "string", "description": "Name of the insurance company" },
        "coverageType": { "type": "string", "description": "Type of insurance coverage (e.g., Auto, Health, Home)" },
        "validFromDate": { "type": "integer", "description": "Start date of insurance coverage (YYYYMMDD)" },
        "validThroughDate": { "type": "integer", "description": "End date of insurance coverage (YYYYMMDD)" },
        "insuredAsset": { "type": "string", "description": "Description or ID of the insured asset (e.g., vehicle VIN, property address)" }
      }
    }
  }
}