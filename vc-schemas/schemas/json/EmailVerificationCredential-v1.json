{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://sfilangio01.github.io/vc-schemas/schemas/json-ld/EmailVerification-v1.json-ld",
      "jsonSchema": "https://sfilangio01.github.io/vc-schemas/schemas/json/EmailVerificationCredential-v1.json"
    },
    "serialization": {
      "indexDataSlotA": "email",
      "indexDataSlotB": "isVerified"
    }
  },
  "required": [
    "@context",
    "id",
    "type",
    "issuanceDate",
    "credentialSubject",
    "credentialSchema",
    "credentialStatus",
    "issuer"
  ],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "id": { "type": "string" },
    "type": { "type": ["string", "array"], "items": { "type": "string" } },
    "issuer": { "type": ["string", "object"], "format": "uri", "required": ["id"], "properties": { "id": { "type": "string", "format": "uri" } } },
    "issuanceDate": { "type": "string", "format": "date-time" },
    "expirationDate": { "type": "string", "format": "date-time" },
    "credentialSchema": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string", "format": "uri" }, "type": { "type": "string" } } },
    "subjectPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "merklizationRootPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "revNonce": { "type": "integer" },
    "version": { "type": "integer" },
    "updatable": { "type": "boolean" },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "email", "isVerified"],
      "properties": {
        "id": { "title": "Credential Subject ID", "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email", "description": "The verified email address" },
        "isVerified": { "type": "boolean", "description": "True if the email address has been verified" },
        "verificationDate": { "type": "integer", "description": "Date of email verification (YYYYMMDD)" }
      }
    }
  }
}