{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://sfilangio01.github.io/vc-schemas/schemas/json-ld/DrivingLicense-v1.json-ld",
      "jsonSchema": "https://sfilangio01.github.io/vc-schemas/schemas/json/DrivingLicenseCredential-v1.json"
    },
    "serialization": {
      "indexDataSlotA": "licenseNumber",
      "indexDataSlotB": "expiryDate"
    }
  },
  "required": [
    "@context",
    "id",
    "type",
    "issuanceDate",
    "credentialSubject",
    "credentialSchema",
    "credentialStatus",
    "issuer"
  ],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "id": { "type": "string" },
    "type": { "type": ["string", "array"], "items": { "type": "string" } },
    "issuer": { "type": ["string", "object"], "format": "uri", "required": ["id"], "properties": { "id": { "type": "string", "format": "uri" } } },
    "issuanceDate": { "type": "string", "format": "date-time" },
    "expirationDate": { "type": "string", "format": "date-time" },
    "credentialSchema": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string", "format": "uri" }, "type": { "type": "string" } } },
    "subjectPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "merklizationRootPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "revNonce": { "type": "integer" },
    "version": { "type": "integer" },
    "updatable": { "type": "boolean" },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "licenseNumber", "issuingAuthority", "issueDate", "expiryDate"],
      "properties": {
        "id": { "title": "Credential Subject ID", "type": "string", "format": "uri" },
        "licenseNumber": { "type": "string", "description": "Driver's license number" },
        "issuingAuthority": { "type": "string", "description": "Authority that issued the license" },
        "issueDate": { "type": "integer", "description": "Date of license issuance (YYYYMMDD)" },
        "expiryDate": { "type": "integer", "description": "Date of license expiry (YYYYMMDD)" },
        "drivingClass": { "type": "string", "description": "Driving class (e.g., A, B, C, D)" }
      }
    }
  }
}