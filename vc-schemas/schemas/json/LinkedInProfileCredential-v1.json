{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://sfilangio01.github.io/vc-schemas/schemas/json-ld/LinkedInProfile-v1.json-ld",
      "jsonSchema": "https://sfilangio01.github.io/vc-schemas/schemas/json/LinkedInProfileCredential-v1.json"
    },
    "serialization": {
      "indexDataSlotA": "linkedInId",
      "indexDataSlotB": "isPremiumMember"
    }
  },
  "required": [
    "@context",
    "id",
    "type",
    "issuanceDate",
    "credentialSubject",
    "credentialSchema",
    "credentialStatus",
    "issuer"
  ],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "id": { "type": "string" },
    "type": { "type": ["string", "array"], "items": { "type": "string" } },
    "issuer": { "type": ["string", "object"], "format": "uri", "required": ["id"], "properties": { "id": { "type": "string", "format": "uri" } } },
    "issuanceDate": { "type": "string", "format": "date-time" },
    "expirationDate": { "type": "string", "format": "date-time" },
    "credentialSchema": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string", "format": "uri" }, "type": { "type": "string" } } },
    "subjectPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "merklizationRootPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "revNonce": { "type": "integer" },
    "version": { "type": "integer" },
    "updatable": { "type": "boolean" },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "linkedInProfileUrl", "fullName"],
      "properties": {
        "id": { "title": "Credential Subject ID", "type": "string", "format": "uri" },
        "linkedInProfileUrl": { "type": "string", "format": "uri", "description": "URL to the verified LinkedIn profile" },
        "fullName": { "type": "string", "description": "Full name from LinkedIn profile" },
        "headline": { "type": "string", "description": "LinkedIn profile headline" },
        "isPremiumMember": { "type": "boolean", "description": "Whether the user is a LinkedIn Premium member" },
        "connectionCount": { "type": "integer", "description": "Number of LinkedIn connections" }
      }
    }
  }
}