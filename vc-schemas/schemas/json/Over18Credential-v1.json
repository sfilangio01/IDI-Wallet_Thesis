{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://sfilangio01.github.io/vc-schemas/schemas/json-ld/Over18-v1.json-ld",
      "jsonSchema": "https://sfilangio01.github.io/vc-schemas/schemas/json/Over18Credential-v1.json"
    },
    "serialization": {
      "indexDataSlotA": "isOver18",
      "indexDataSlotB": "documentType"
    }
  },
  "required": [
    "@context",
    "id",
    "type",
    "issuanceDate",
    "credentialSubject",
    "credentialSchema",
    "credentialStatus",
    "issuer"
  ],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "id": { "type": "string" },
    "type": { "type": ["string", "array"], "items": { "type": "string" } },
    "issuer": { "type": ["string", "object"], "format": "uri", "required": ["id"], "properties": { "id": { "type": "string", "format": "uri" } } },
    "issuanceDate": { "type": "string", "format": "date-time" },
    "expirationDate": { "type": "string", "format": "date-time" },
    "credentialSchema": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string", "format": "uri" }, "type": { "type": "string" } } },
    "subjectPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "merklizationRootPosition": { "type": "string", "enum": ["none", "index", "value"] },
    "revNonce": { "type": "integer" },
    "version": { "type": "integer" },
    "updatable": { "type": "boolean" },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "isOver18"],
      "properties": {
        "id": { "title": "Credential Subject ID", "type": "string", "format": "uri" },
        "isOver18": { "type": "boolean", "description": "True if the subject is 18 years or older" },
        "documentType": { "type": "integer", "description": "Type of document used for age verification" },
        "verificationDate": { "type": "integer", "description": "Date of verification (YYYYMMDD)" }
      }
    }
  }
}