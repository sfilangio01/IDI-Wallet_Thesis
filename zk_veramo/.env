# Blockchain settings
BLOCKCHAIN=polygon
ETH_NETWORK=mumbai  # Or goerli, depending on where you want to test
RPC_URL=https://rpc-mumbai.maticvigil.com  # Or your preferred RPC provider URL
# Issuer settings
